# BizLedger Environment Configuration
# Optional: Connect to Supabase for multi-device Cloud Synchronization
# If omitted or left empty, BizLedger runs in complete offline-first mode with IndexedDB local storage.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
